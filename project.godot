; Wavebreak — a survivors-like foundation.
; Working title; rename config/name and assembly_name together when you pick one.

config_version=5

[application]

config/name="Wavebreak"
run/main_scene="res://scenes/Title.tscn"
config/features=PackedStringArray("4.4", "C#", "Forward Plus")
config/icon="res://icon.svg"
config/version="1.1.0"
config/windows_native_icon="res://icon.ico"
boot_splash/bg_color=Color(0.078, 0.086, 0.122, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/splash.png"
boot_splash/stretch_mode=0
boot_splash/use_filter=true

[dotnet]

project/assembly_name="Wavebreak"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/wavebreak_steam/plugin.cfg")

